<package format="2">
  <name>kobuki_ros</name>
  <version>1.0.0</version>
  <description>
    ROS 2 runtime software for Kobuki, Yujin Robot's mobile research base.
  </description>
  <author>Daniel Stonier</author>
  <author>Younghun Ju</author>
  <author>Jorge Santos Simon</author>
  <author>Marcus Liebhardt</author>
  <maintainer email="d.stonier@gmail.com">Daniel Stonier</maintainer>
  <license>BSD</license>
  <url type="bugtracker">https://github.com/kobuki-base/kobuki_ros/issues</url>
  <url type="repository">https://github.com/kobuki-base/kobuki_ros</url>
  <url type="website">http://ros.org/wiki/kobuki</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>kobuki_description</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
